# ---------------------------------------------------------------------------
# Harmonia — environment variables (copy to .env / frontend/.env.local)
# No secrets or API keys are required to run the project locally.
# ---------------------------------------------------------------------------

# ----- Backend (FastAPI) ---------------------------------------------------
# Paths may be absolute or relative to the repository root.
HARMONIA_DATA_PATH=data/spotify_millsongdata_with_genres.csv
HARMONIA_NOTEBOOK_VECTORIZER_PATH=data/tfidf_vectorizer_contentonly.pkl
HARMONIA_ARTIFACTS_DIR=artifacts
# Build the TF-IDF artifacts on first start if they are missing (true/false).
HARMONIA_BUILD_ON_STARTUP=true
# Comma-separated browser origins allowed to call the API.
HARMONIA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host/port are passed to uvicorn on the command line (see README).

# ----- Frontend (Next.js) --------------------------------------------------
# Put this one in frontend/.env.local (NEXT_PUBLIC_* is baked in at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
